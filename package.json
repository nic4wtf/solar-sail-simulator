  "version": "1.4.0",
  "description": "Interactive solar sail performance simulator for Earth-orbit, Earth-Moon and interplanetary mission analysis",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc -b --force && vite build",
